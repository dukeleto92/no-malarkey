/* Favreau Senate addendum (doc, end of Q13). Gate per bible §5:
     hosts_burned >= 2 AND rec_progressive <= -3
   v0.7's threshold of 3 required the unique maximal burn path (hosts_burned
   tops out at exactly 3: Q1 A3 + Q3a A2 + one of Q12 A2 / Q12 A4-fail), which
   hard-gated the secret path on the Q2 healthcare route. Lowering it to 2 opens
   several combinations, and the widened +-3 progressive clamp is what keeps the
   moderate floor doing independent work: three of the four burn sources also
   write rec_progressive -1, so on the old +-2 clamp two burns had all but
   guaranteed the floor. Reaching -3 now takes a further moderate move. */
var NM_FAVREAU_GATE = { hosts_burned_min: 2, progressive_max: -3 };

/* Gate ladder (bible §2.3): each delivery(prior) read sits at half the
   reachable delivery ceiling at that point, rounded down. Q8 is the anchor.
   Recompute the whole ladder if a new delivery source is ever added. */
var NM_GATE = {
    q7_contained: 1,   // ceiling +3
    q8_strong: 2,      // ceiling +4  (anchor)
    q9_confirmed: 3,   // ceiling +6
    q12_viral: 4,      // ceiling +9
    q13_hold: 5,       // ceiling +10, -1 with midterm_push
    q14_muscle: 6      // ceiling +12
};

// Q13 A2/A3 compound gate: the tally band, or one step lower with midterm_push.
function nmQ13Hold() {
    return nm.delivery >= NM_GATE.q13_hold
        || (nm.midterm_push && nm.delivery >= NM_GATE.q13_hold - 1);
}

function nmFavreauSenate() {
    if (NM_FAVREAU_GATE.hosts_burned_min === null) return false;
    if (NM_FAVREAU_GATE.progressive_max === null) return false;
    return nm.hosts_burned >= NM_FAVREAU_GATE.hosts_burned_min
        && nm.rec_progressive <= NM_FAVREAU_GATE.progressive_max;
}

