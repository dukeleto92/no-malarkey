            break;

        // ---- Q10 — Crossfire Hurricane ----
        case 8131: nmAdd("rec_legitimacy", 2); break;
        case 8132: nmAdd("rec_progressive", 1); nmAdd("rec_legitimacy", -1); nm.norms_weaponized = true; break;
        case 8133: nmAdd("rec_progressive", -1); break;
        case 8134: nmAdd("rec_legitimacy", 1); break;

        // ---- Q11 — Executive Time (flows into Q12 at index 14) ----
        /* A1 pays 0, not the v0.8 +1 (bible §D) — the other answer the flagless
           questions hid from v0.8's correction pass. A five-capital tour
           delivers nothing material; Pfeiffer's favourable contrast with
           Republican chaos is positioning, and it is already paid for with the
           rec_legitimacy +1 on the same line. Compare A2 and A4, which sign
           instruments that survive contact with the world.

           Before this, three of Q11's four answers paid a flat +1 with no gate,
           no flag and no risk, which made Q11 the single densest free-delivery
           node in the mod. Now +1 is what the two enacting answers pay. */
        case 8141: nmAdd("delivery", 0); nmAdd("rec_legitimacy", 1); nm.nato_tour = true; nmAfterQ11(); break;
        // A2 pays +1, not the v0.7 +2: it was the largest unconditional delivery
        // grant in the mod, and its closest analogue (Q3c A2) pays +1 (bible §2.1).
        case 8142: nmAdd("delivery", 1); nmAdd("rec_progressive", 1); nmAdd("rec_legitimacy", -1); nmAdd("warren_relationship", 1); nm.debt_relief = true; nmAfterQ11(); break;
        /* A3 moves no tally; it banks midterm_push, the discount on the Q13
           A2/A3 gate and that flag's only consumer (bible §3.1). A1's correction
           above sharpens what A3 costs — it now forgoes the +1 that A2 and A4
           pay, and §G's 2-point discount is what finally makes that trade worth
           taking. See NM_GATE.q13_push_discount. */
        case 8143: nmAdd("delivery", 0); nm.midterm_push = true; nmAfterQ11(); break;
        case 8144: nmAdd("delivery", 1); nmAdd("rec_labor", 2); nmAdd("rec_progressive", 1); nmAfterQ11(); break;

        // ---- Q12 — Warren Relationship (index 14, flows into Q13 at index 15) ----
        // No jump: Q13 is the next slot, so the natural increment is correct.
        // nmAfterQ12 must run last in each case — it reads the tallies this
        // answer just moved (hosts_burned feeds the Favreau gate).
        case 8161: nmAdd("delivery", 0); nmAdd("warren_relationship", 1); nmAdd("rec_progressive", 1); nmAfterQ12(); break;
        case 8162: nmAdd("delivery", 0); nmAdd("warren_relationship", -1); nm.hosts_burned++; nmAfterQ12(); break;
        /* A3 pays 0, not +1 — a third instance of §D's class, and a fourth
           spec/document desync alongside §A's three. §C records Q12 A3 as
           "already 0" in the live document; it is not, it was +1. It matters
           because the doc's own v0.9 arithmetic is computed against 0: the
           §B.2 floor_safe walk takes Q12 A1 as the best free answer, and §F's
           ceiling drops from +10 to +9 at the Q13 read. With +1 standing, both
           columns come out a point high from Q13 onward and §E.2's Q14 gate no
           longer re-derives. Handing Liz an antitrust portfolio that wins
           "modestly successful" cases is a partial, so 0 is also the right
           read on its own terms. */
        case 8163: nmAdd("delivery", 0); nmAdd("warren_relationship", 1); nmAfterQ12(); break;
        case 8164:
            if (nm.delivery >= NM_GATE.q12_viral) { nmAdd("delivery", 0); nmAdd("rec_progressive", 1); }
            else { nmAdd("delivery", 0); nmAdd("rec_progressive", -1); nmAdd("warren_relationship", -1); nm.hosts_burned++; }
            nmAfterQ12();
            break;

        /* ---- Q13 — Midterms (index 15, flows into Q14 at index 16) ----
           Each answer reads its condition off the *prior* tallies, so every test
           runs before this answer's own nmAdd calls. A2 is the sole route to
           dem_house (bible §3.1 invariant); A3 tops out at status_quo. No jump:
           Q14 is the next slot. nmAfterQ13 runs last — it reads what this answer
           just wrote.

           midterm_result is new in v0.9 (bible §K). Q13 sat outside §2.1
           entirely: with no result flag the write rule had nothing to classify
           against, so its grants were hand-set and came out inconsistent —
           A3's success paid 0 while A1's paid +1 though both land status_quo.
           With the flag the grants are simply what the rule says:

               A2 success  record-gated win   +2      A2 failure  -2 *
               A1 success  win                +1      all others  -1
               A3, A4 success  partial         0

           * A2's -2 is the one declared exception: it is the largest swing in
           the phase in both directions and the reason its gate is worth
           reaching for. Every other failure is a flat loss at -1. The grants
           below are unchanged by the flag — that they already matched the rule
           is the good sign §K was looking for. Q13 is now the second-largest
           delivery swing in the mod and is legible to the validator. */
        case 8171:
            if (nm.rec_progressive >= 1) { nmAdd("delivery", 1); nm.midterm_result = "win"; nm.congress_2019 = "status_quo"; }
            else { nmAdd("delivery", -1); nm.midterm_result = "loss"; nm.congress_2019 = "gop_senate"; }
            nmAfterQ13();
            break;
        case 8172:
            if (nmQ13Hold()) { nmAdd("delivery", 2); nm.midterm_result = "win"; nm.congress_2019 = "dem_house"; }
            else { nmAdd("delivery", -2); nm.midterm_result = "loss"; nm.congress_2019 = "gop_senate"; }
            nmAdd("rec_labor", 1); // both branches
            nmAfterQ13();
            break;
        case 8173:
            if (nmQ13Hold()) { nmAdd("delivery", 0); nm.midterm_result = "partial"; nm.congress_2019 = "status_quo"; }
            else { nmAdd("delivery", -1); nm.midterm_result = "loss"; nm.congress_2019 = "gop_senate"; }
            nmAfterQ13();
            break;
        case 8174:
            if (nm.norms_weaponized) { nmAdd("delivery", 0); nm.midterm_result = "partial"; nm.congress_2019 = "status_quo"; }
            else { nmAdd("delivery", -1); nm.midterm_result = "loss"; nm.congress_2019 = "gop_senate"; }
            nmAfterQ13();
            break;

        // ---- Q14 — Immigration (last drafted question; ends the run) ----
        // Positional-write principle (bible §6.5): rec_progressive records the
        // position and so fires on both branches of an answer, while delivery
        // records whether it worked. A1 and A3 win through a record-gated branch
        // and pay +2; A2's win is partly ungated by the gop_senate relief, so it
        // stays at +1 (bible §2.1, Q14 A2 exception).
        // Jump lands question_number on 17, which the engine increments to 18 =
        // question_count — election night fires only on strict equality, and the
        // jump also steps over the terminal question parked at index 17.
        //
        // nmEndGovern() runs before the jump on every branch: it is where the
        // Republicans stop being "The Republicans" and acquire a nominee. It has
        // to come after this answer's own nmAdd calls, because the last of them
        // can be the point that clears Jeb's +11 or drops the run to the
        // delivery <= 0 band that hands the nomination back to Trump.
        case 8181:
            if (nm.congress_2019 === "dem_house") {
                nmAdd("delivery", 2); nmAdd("rec_immigration", 2); nm.immigration_result = "win";
            } else {
                nmAdd("delivery", -1); nm.immigration_result = "loss";
            }
            nmAdd("rec_progressive", 1); // both branches
            nmEndGovern();
            campaignTrail_temp.question_number = 17;
            break;
        case 8182:
            if (nm.delivery >= NM_GATE.q14_muscle || nm.congress_2019 === "gop_senate") {
                nmAdd("delivery", 1); nmAdd("rec_immigration", -1); nm.immigration_result = "win";
            } else {
                nmAdd("delivery", -1); nm.immigration_result = "loss";
            }
            nmAdd("rec_progressive", -1); // both branches
            nmEndGovern();
            campaignTrail_temp.question_number = 17;
            break;
        case 8183:
            // Nixon-to-China: the moderate-coded answer needs a progressive record.
            if (nm.rec_progressive >= 2) {
                nmAdd("delivery", 2); nmAdd("rec_immigration", 1); nm.immigration_result = "win";
            } else {
                nmAdd("delivery", -1); nm.immigration_result = "loss";
            }
            nmAdd("rec_progressive", -1); // both branches
            nmEndGovern();
            campaignTrail_temp.question_number = 17;
            break;
        case 8184:
            // The duck: no gate, and the pen costs legitimacy. Bible §9.9 notes
            // the drafted prose does not yet earn that -1; the write stands and
            // the prose gets teeth in a later pass.
            nmAdd("rec_immigration", 1); nmAdd("rec_legitimacy", -1);
            nm.immigration_result = "partial";
            nmEndGovern();
            campaignTrail_temp.question_number = 17;
            break;

        // ---- A HOUSE OF DYNAMITE terminal ----
        // No jump needed: index 17 + 1 = 18 = question_count, so the game ends.
        // The govern phase ends here too, seven questions early, and the cascade
        // still has to run: election night follows this answer, and an unnamed
        // opponent on the final map is a bug, not a mood. The record is short
        // and the axes are barely moved, so this route lands on the roster's
        // outer rows — Trump or Christie on a failing record, Ted Cruz on a
        // positive one, with the middle seven mostly out of reach.
        // TODO: replace election night with a proper ending screen at the pivot build.
        case 8151: nmEndGovern(); break;
    }
    nmPaintTracker(); // every answer is a write; refresh the read-out
};

/* ============================================================
   Progress bar — display-only relabelling.

   The player plays fourteen questions. questions_json holds eighteen slots,
   because Q3 is one question with four mutually exclusive branch slots and
   the terminal is parked at the end. NM_DISPLAY maps a question's pk to the
   number the player should actually see.
   ============================================================ */
var NM_SPINE_TOTAL = 14;
var NM_DISPLAY = {
    801: 1, 802: 2,
    803: 3, 804: 3, 805: 3, 806: 3,   // Q3a-d — one question, four variants
    807: 4, 808: 5, 809: 6, 810: 7, 811: 8, 812: 9,
    813: 10, 814: 11, 816: 12, 817: 13, 818: 14
    // 815, A HOUSE OF DYNAMITE, is a terminal and not on the spine
};

// `e ||= campaignTrail_temp` in the engine, so this is the live index.
function nmCurrentQuestionPk() {
    var qs = campaignTrail_temp.questions_json, n = campaignTrail_temp.question_number;
    return (qs && qs[n]) ? qs[n].pk : null;
}

function nmPaintProgress() {
    try {
        var el = document.querySelector("#progress_bar h3");
        if (!el) return;
        var pk = nmCurrentQuestionPk();
        var text = NM_DISPLAY[pk] ? "Question " + NM_DISPLAY[pk] + " of " + NM_SPINE_TOTAL
                                  : (pk === 815 ? "Crisis" : null);
        // The guard also stops the observer below from re-entering: the second
        // pass finds the text already correct and writes nothing.
        if (text && el.textContent !== text) el.textContent = text;
    } catch (e) { /* a mislabelled bar must never cost the run */ }
}

/* The engine rebuilds #progress_bar inside questionHTML() on every paint, so
   the relabel has to run again each time. Watching the game window covers
   every path that repaints it — questions, visits, feedback dismissals —
   without wrapping any engine function. */
function nmWatchProgress() {
    var target = document.getElementById("game_window") || document.body;
    if (window.MutationObserver && target) {
        new window.MutationObserver(nmPaintProgress).observe(target, { childList: true, subtree: true });
    } else {
        setInterval(nmPaintProgress, 300);
    }
    nmPaintProgress();
}

/* ============================================================
   Variable tracker — a live read-out of the player's record,
   pinned beside the game window and repainted after every answer.

   It shows the tallies a president could reasonably be expected to
   know he is accumulating. It deliberately omits the hidden layer:
   `hosts_burned` and `favreau_senate` (bible §3.2 — the secret path
   stops being secret the moment it has a counter on screen) and the
   Q3c pre-rolls (the gamble's odds stay hidden). It shows current
   values only, never the gate a question is about to read.
   ============================================================ */
var NM_TRACKER = {
    sections: [
        { title: "Record", rows: [
            { key: "delivery",       label: "Delivery" },
            { key: "rec_legitimacy", label: "Legitimacy" }
        ] },
        { title: "Position", rows: [
            { key: "rec_progressive",     label: "Progressive", clamp: 3 },
            { key: "rec_social",          label: "Social",      clamp: 2 },
            { key: "rec_foreign",         label: "Foreign",     clamp: 2 },
            { key: "warren_relationship", label: "Warren",      clamp: 2 }
        ] },
        { title: "Issues", rows: [
            { key: "rec_labor",          label: "Labor",          clamp: 3 },
            { key: "rec_healthcare",     label: "Healthcare",     clamp: 3 },
            { key: "rec_infrastructure", label: "Infrastructure", clamp: 3 },
            { key: "rec_immigration",    label: "Immigration",    clamp: 3 },
            { key: "rec_trade",          label: "Trade",          clamp: 3 }
        ] }
    ],
    // Resolved outcomes — only rendered once the question that writes them has run
    outcomes: [
        { key: "healthcare_result",  label: "Healthcare" },
        { key: "guns_result",        label: "Guns" },
        { key: "scotus_result",      label: "Court" },
        { key: "congress_2019",      label: "Congress" },
        { key: "immigration_result", label: "Immigration" },
        /* Appears only once the cascade has fired, which is the point: until
           then the row is absent and the opponent is "The Republicans"
           everywhere the player can look. The gate that selected the nominee
           is not shown — the tracker's rule is current values, never the
           threshold a question is about to read (or has just read). */
        { key: "gop_nominee",        label: "GOP nominee" }
    ],
    // Booleans the player set by an explicit choice; shown only once true
    marks: [
        { key: "nato_tour",        label: "NATO tour" },
        { key: "debt_relief",      label: "Debt relief" },
        { key: "midterm_push",     label: "Midterm push" },
        { key: "norms_weaponized", label: "Trump prosecuted" },
        { key: "harris_scotus",    label: "Harris on the Court" }
    ],
    open: true
};

/* Outcome values to the short tag the tracker prints. The nine nominee keys
   share the table with the result flags; they are surnames, so a key that ever
   collides with a flag value would be a bug in the roster, not here. */
var NM_OUTCOME_LABEL = {
    win: "won", partial: "partial", loss: "lost",
    dem_house: "Dem House", status_quo: "split", gop_senate: "GOP sweep",
    trump: "Trump", christie: "Christie", jeb: "Bush", rubio: "Rubio",
    haley: "Haley", paul: "Paul", pence: "Pence", carlson: "Carlson",
    cruz: "Cruz"
};

function nmSigned(v) { return (v > 0 ? "+" : "") + v; }

/* A centre-anchored bar for the clamped axes: the fill runs left or right
   of the midline in proportion to how far the axis has travelled. Graded
   accumulators (delivery, legitimacy) have no ceiling, so they get a
   number and no bar. */
function nmTrackerBar(v, clamp) {
    if (!clamp) return "";
    var pct = Math.min(Math.abs(v) / clamp, 1) * 50;
    var side = v < 0 ? "right:50%" : "left:50%";
    return "<span class='nm_tk_track'><span class='nm_tk_fill' style='" + side +
           ";width:" + pct + "%'></span></span>";
}

function nmTrackerHTML() {
    var h = "";
    for (var s = 0; s < NM_TRACKER.sections.length; s++) {
        var sec = NM_TRACKER.sections[s];
        h += "<div class='nm_tk_head'>" + sec.title + "</div>";
        for (var r = 0; r < sec.rows.length; r++) {
            var row = sec.rows[r], v = nm[row.key];
            h += "<div class='nm_tk_row'><span class='nm_tk_label'>" + row.label + "</span>" +
                 nmTrackerBar(v, row.clamp) +
                 "<span class='nm_tk_val" + (v > 0 ? " nm_tk_pos" : v < 0 ? " nm_tk_neg" : "") + "'>" +
                 nmSigned(v) + "</span></div>";
        }
    }
    var out = "";
    for (var o = 0; o < NM_TRACKER.outcomes.length; o++) {
        var oc = NM_TRACKER.outcomes[o], ov = nm[oc.key];
        if (!ov) continue;
        out += "<div class='nm_tk_row'><span class='nm_tk_label'>" + oc.label + "</span>" +
               "<span class='nm_tk_tag'>" + (NM_OUTCOME_LABEL[ov] || ov) + "</span></div>";
    }
    for (var m = 0; m < NM_TRACKER.marks.length; m++) {
        var mk = NM_TRACKER.marks[m];
        if (!nm[mk.key]) continue;
        out += "<div class='nm_tk_row'><span class='nm_tk_label'>" + mk.label + "</span>" +
               "<span class='nm_tk_tag'>yes</span></div>";
    }
    if (out) h += "<div class='nm_tk_head'>Outcomes</div>" + out;
    return h;
}

function nmPaintTracker() {
    try {
        var el = document.getElementById("nm_tracker_body");
        if (!el) return;
        el.innerHTML = nmTrackerHTML();
    } catch (e) { /* never let the read-out break the run */ }
}

/* The panel stays hidden through election select, candidate select and the
   bios, and appears with the first question. `#progress_bar` is built by the
   engine's questionHTML() and exists on no earlier screen, which makes it the
   cleanest "the game has actually started" marker available to a mod. */
function nmGameStarted() {
    return !!document.getElementById("progress_bar");
}

function nmWatchForGameStart(box) {
    if (nmGameStarted()) { box.style.display = ""; nmPaintTracker(); return; }
    box.style.display = "none";
    var poll = setInterval(function () {
        try {
            if (!nmGameStarted()) return;
            clearInterval(poll);
            box.style.display = "";
            nmPaintTracker();
        } catch (e) { clearInterval(poll); }
    }, 400);
}

function nmBuildTracker() {
    if (document.getElementById("nm_tracker")) return;
    var box = document.createElement("div");
    box.id = "nm_tracker";
    box.innerHTML =
        "<div id='nm_tracker_bar'><span>The Record</span>" +
        "<button type='button' id='nm_tracker_toggle' aria-expanded='true'>&minus;</button></div>" +
        "<div id='nm_tracker_body'></div>";
    document.body.appendChild(box);
    // Collapsed by default on narrow viewports, where it would sit over the map
    if (window.innerWidth < 1180) NM_TRACKER.open = false;
    var toggle = document.getElementById("nm_tracker_toggle");
    function applyOpen() {
        box.className = NM_TRACKER.open ? "" : "nm_tk_closed";
        toggle.innerHTML = NM_TRACKER.open ? "&minus;" : "+";
        toggle.setAttribute("aria-expanded", NM_TRACKER.open ? "true" : "false");
    }
    toggle.onclick = function () { NM_TRACKER.open = !NM_TRACKER.open; applyOpen(); };
    document.getElementById("nm_tracker_bar").onclick = function (ev) {
        if (ev.target !== toggle) { NM_TRACKER.open = !NM_TRACKER.open; applyOpen(); }
    };
    applyOpen();
    nmPaintTracker();
    nmWatchForGameStart(box);
}

/* ============================================================
   GOP nominee cascade (bible §4.1; gate table under "Republican
   Candidate Profiles" in the doc's Mod Description section).

   Nine possible opponents, one cascade, FIRST MATCH WINS — so the
   array order below IS the rule, and it is the doc's order, which
   is not the order the old scaffolding had (the doc puts Pence
   seventh, after Rand Paul; the scaffolding had him fifth). Moving
   him changes outcomes: a player at rec_social +2, rec_progressive
   +2, rec_foreign -2 matches both Haley and Pence, and the doc
   hands that player Haley.

       #  nominee            gate
       1  Donald Trump       delivery <= 0 AND NOT norms_weaponized
       2  Chris Christie     delivery <= 0 AND norms_weaponized
       3  Jeb Bush           delivery >= +11
       4  Marco Rubio        rec_progressive >= +3 AND rec_social >= +1
       5  Nikki Haley        rec_foreign <= -2 AND rec_progressive >= 0
       6  Rand Paul          rec_foreign >= +2 AND rec_progressive <= 0
       7  Mike Pence         rec_social >= +2 AND rec_progressive >= +2
       8  Tucker Carlson     rec_progressive <= -3 AND hosts_burned < 2
       9  Ted Cruz           else

   Three properties of the table that are load-bearing and easy to
   break by editing a row in isolation:

     - Rows 1 and 2 between them cover every delivery <= 0 run, so
       rows 3-8 are only ever evaluated at delivery >= +1. A failed
       presidency cannot draw Rubio or Rand Paul no matter what its
       positional record looks like; it draws the man who never
       conceded, or — if you put him in the dock — the prosecutor.
     - Jeb's +11 is measured against an end-of-govern delivery
       ceiling of +13 (the ledger at the top of this file). It is
       the near-perfect run, and it is meant to be: the fever breaks
       and the party goes back to the family.
     - Tucker's second clause reads the hidden host counter, which
       is the same counter the Favreau Senate path gates on at
       >= 2 (NM_FAVREAU_GATE). Burning Keepin' It 1600 twice does
       not merely open the secret path, it closes the primetime
       host out of the nomination — the two hidden outcomes are
       mutually exclusive by construction.

   `delivery` here is the final govern-phase figure, read after the
   last question's own writes have landed. Every axis is read at its
   clamped value, so Rubio's +3 and Tucker's -3 are the
   rec_progressive rails exactly (§2), and Haley's -2 / Paul's +2 are
   the rec_foreign rails.

   Colors follow the mod scheme: GOP #FF0000 / #FFA0A0, applied by
   nmSetNominee so a roster row never has to restate them.

   A row is a name, a home state, and a gate — nothing else, on
   purpose. An opponent in this engine has no bio and no portrait to
   fill. `description` is a genuinely dead field on this record:
   descHTML() is only ever called for the player's own candidate and
   running mate, and there is no opponent bio screen to reach.
   `image_url` has exactly one consumer, the winner's photo on the
   final results screen, which the opposition only reaches by beating
   you; left empty it falls back to the election's
   no_electoral_majority_image, the same way the base game handles
   any candidate without a portrait. Neither is worth nine rows of
   prose and nine sourced photographs. If a later build gives the
   pivot a screen that introduces the nominee properly, that screen
   brings its own copy and art with it.
   ============================================================ */
var NM_GOP_PK = 301;
var NM_GOP_COLORS = { color_hex: "#FF0000", secondary_color_hex: "#FFA0A0" };
var NM_GOP_ROSTER = [
    {
        key: "trump", first_name: "Donald", last_name: "Trump", state: "Florida",
        gate: function () { return nm.delivery <= 0 && !nm.norms_weaponized; }
    },
    {
        key: "christie", first_name: "Chris", last_name: "Christie", state: "New Jersey",
        gate: function () { return nm.delivery <= 0 && nm.norms_weaponized; }
    },
    {
        key: "jeb", first_name: "Jeb", last_name: "Bush", state: "Florida",
        gate: function () { return nm.delivery >= 11; }
    },
    {
        key: "rubio", first_name: "Marco", last_name: "Rubio", state: "Florida",
        gate: function () { return nm.rec_progressive >= 3 && nm.rec_social >= 1; }
    },
    {
        key: "haley", first_name: "Nikki", last_name: "Haley", state: "South Carolina",
        gate: function () { return nm.rec_foreign <= -2 && nm.rec_progressive >= 0; }
    },
    {
        key: "paul", first_name: "Rand", last_name: "Paul", state: "Kentucky",
        gate: function () { return nm.rec_foreign >= 2 && nm.rec_progressive <= 0; }
    },
    {
        key: "pence", first_name: "Mike", last_name: "Pence", state: "Indiana",
        gate: function () { return nm.rec_social >= 2 && nm.rec_progressive >= 2; }
    },
    {
        key: "carlson", first_name: "Tucker", last_name: "Carlson", state: "Maine",
        gate: function () { return nm.rec_progressive <= -3 && nm.hosts_burned < 2; }
    },
    {
        key: "cruz", first_name: "Ted", last_name: "Cruz", state: "Texas",
        gate: null // the `else` row — must stay last
    }
];

/* Returns the fields object for the opposition slot, or null if something has
   removed it. Everything downstream tolerates the null: a mod that cannot find
   pk 301 should leave the opponent reading "The Republicans" rather than throw
   in the middle of the last question of the run. */
function nmGopFields() {
    var cands = campaignTrail_temp.candidate_json;
    for (var i = 0; i < cands.length; i++) {
        if (cands[i].pk === NM_GOP_PK) return cands[i].fields;
    }
    return null;
}

/* Names the opposition, and does nothing else. The name is the only thing on
   this record a player ever sees, so it is the only thing worth writing: no
   bio, no portrait, no per-nominee ending text. state comes along because it
   is identity rather than prose, and costs one assignment.

   Everything left alone is the party's rather than the nominee's — priority,
   party, is_active, candidate_score, the ending messages — and every score row
   in Code 2 is keyed to the pk, which does not move. The colors are rewritten
   even though pk 301 already carries them, so the opposition is GOP-red at
   election night whatever else has touched the record by then. */
function nmSetNominee(row) {
    var f = nmGopFields();
    if (!f) return;
    f.first_name = row.first_name;
    f.last_name = row.last_name;
    f.state = row.state;
    f.color_hex = NM_GOP_COLORS.color_hex;
    f.secondary_color_hex = NM_GOP_COLORS.secondary_color_hex;
    nm.gop_nominee = row.key;
}

/* The cascade. First match wins; the last row has a null gate and always
   matches, so this cannot fall through. Idempotent — a second call re-reads
   the same final tallies and writes the same nominee — but it is only ever
   called once, at the end of the govern phase.

   Every gate reads a tally the player has finished writing by then, which is
   why this runs here and not, say, at election night: nothing after the last
   question can move delivery, rec_progressive, rec_social, rec_foreign,
   norms_weaponized or hosts_burned, and the map has to be able to show the
   name from the next paint onwards. */
function nmResolveNominee() {
    for (var i = 0; i < NM_GOP_ROSTER.length; i++) {
        var row = NM_GOP_ROSTER[i];
        if (!row.gate || row.gate()) {
            nmSetNominee(row);
            return row;
        }
    }
    return null;
}

