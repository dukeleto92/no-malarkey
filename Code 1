        // visit-only screen, if next question pk is in spine and not a skipped
        // branch, ++. Simpler still: map pk -> display number:
        //   801→1, 802→2, 803-806→3, 807→4, … 818→14, 815→null

        var NM_DISPLAY = {
          801:1, 802:2, 803:3, 804:3, 805:3, 806:3,
          807:4, 808:5, 809:6, 810:7, 811:8, 812:9,
          813:10, 814:11, 816:12, 817:13, 818:14
