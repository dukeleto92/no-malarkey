            // Pre-roll the Q3c RNG beats so the correct feedback can be written now
            nm.q3c_a2_success = Math.random() < 0.85;
            nm.q3c_a3_success = Math.random() < 0.55;
            nmSetFeedback(8052, nm.q3c_a2_success ? NM_FB.q3c_a2_win : NM_FB.q3c_a2_fail);
            nmSetFeedback(8053, nm.q3c_a3_success ? NM_FB.q3c_a3_win : NM_FB.q3c_a3_fail);
            campaignTrail_temp.question_number = 3;
            break;
        case 8024: nmAdd("rec_progressive", -1); nm.route = "3d"; campaignTrail_temp.question_number = 4; break;

        // ---- Q3a — Public Option ----
        case 8031: nmAdd("delivery", 1); nmAdd("rec_healthcare", 1); nmAdd("rec_progressive", -1); nm.healthcare_result = "win"; nmAfterQ3(); break;
        case 8032: nmAdd("delivery", 1); nmAdd("rec_healthcare", 1); nmAdd("rec_progressive", -1); nm.healthcare_result = "win"; nm.hosts_burned++; nmAfterQ3(); break;
        case 8033: nm.healthcare_result = "partial"; nmAfterQ3(); break;
        case 8034: nmAdd("delivery", -1); nmAdd("rec_progressive", 1); nm.healthcare_result = "loss"; nmAfterQ3(); break;

        // ---- Q3b — Medicare for All ----
        case 8041: nmAdd("rec_progressive", -1); nm.healthcare_result = "partial"; nmAfterQ3(); break;
        case 8042: nmAdd("delivery", -1); nmAdd("rec_progressive", 1); nm.healthcare_result = "loss"; nmAfterQ3(); break;
        case 8043: nmAdd("delivery", 1); nmAdd("rec_healthcare", 1); nm.healthcare_result = "win"; nmAfterQ3(); break;

        // ---- Q3c — Executive Order (RNG pre-rolled at Q2) ----
        case 8051: nmAdd("rec_healthcare", 1); nm.healthcare_result = "partial"; nmAfterQ3(); break;
        case 8052:
            if (nm.q3c_a2_success) { nmAdd("delivery", 1); nmAdd("rec_healthcare", 1); nmAdd("rec_legitimacy", 1); nm.healthcare_result = "win"; }
            else { nmAdd("delivery", -1); nm.healthcare_result = "loss"; }
            nmAfterQ3(); break;
        case 8053:
            if (nm.q3c_a3_success) { nmAdd("delivery", 1); nmAdd("rec_healthcare", 2); nmAdd("rec_progressive", 1); nm.healthcare_result = "win"; }
            else { nmAdd("delivery", -1); nmAdd("rec_progressive", 1); nm.healthcare_result = "loss"; }
            nmAfterQ3(); break;

        // ---- Q3d — Subsidies Deal ----
        case 8061: nmAdd("delivery", -1); nm.healthcare_result = "loss"; nmAfterQ3(); break;
        case 8062: nmAdd("delivery", 1); nmAdd("rec_healthcare", 1); nmAdd("rec_progressive", -1); nm.healthcare_result = "win"; nmAfterQ3(); break;
        case 8063: nmAdd("delivery", 1); nmAdd("rec_progressive", -1); nm.healthcare_result = "win"; nmAfterQ3(); break;

        // ---- Q4 — Infrastructure (reads healthcare_result) ----
        case 8071:
            if (nm.healthcare_result === "win") { nmAdd("delivery", 1); nmAdd("rec_infrastructure", 2); nmAdd("rec_progressive", 1); }
            else { nmAdd("rec_infrastructure", 1); nmAdd("rec_progressive", 1); }
            break;
        case 8072:
            if (nm.healthcare_result === "win") { nmAdd("delivery", 1); nmAdd("rec_infrastructure", 1); nmAdd("rec_progressive", -1); }
            else { nmAdd("delivery", -1); nmAdd("rec_progressive", -1); }
            break;
        case 8073: nmAdd("rec_infrastructure", 1); nmAdd("rec_progressive", -1); break;

        // ---- Q5 — TPP ----
        case 8081: nmAdd("delivery", 1); nmAdd("rec_trade", 1); nmAdd("rec_labor", 1); break;
        case 8082: nmAdd("rec_labor", 2); nmAdd("rec_progressive", 1); nmAdd("rec_trade", -1); break;
        case 8083: nmAdd("delivery", 1); nmAdd("rec_trade", 2); nmAdd("rec_labor", -2); nmAdd("rec_progressive", -1); break;

        // ---- Q6 — Afghanistan ----
        case 8091: nmAdd("rec_foreign", -2); nmAdd("delivery", -1); nmAfterQ6(); break;
        case 8092: nmAfterQ6(); break;
        case 8093: nmAdd("rec_foreign", 2); nmAdd("warren_relationship", -1); nmAdd("rec_progressive", -1); nmAfterQ6(); break;

        // ---- Q7 — North Korea ----
        case 8101: nmAdd("rec_foreign", -1); nmAfterQ7(); break;
        case 8102:
            // The doc's dangling fourth FX-ELSE is dead code and is dropped per bible §9.4
            if (nm.rec_foreign >= 2) {
                nm.terminal = "HOUSE_OF_DYNAMITE"; // no tallies, hard stop (bible §8)
                campaignTrail_temp.question_number = 13; // next shown = index 14 (terminal)
            } else if (nm.delivery >= 1) {
                nmAdd("rec_foreign", 2); nmAdd("delivery", 1); nmAfterQ7(); // CONTAINED
            } else {
                nmAdd("rec_foreign", 2); nmAdd("delivery", -1); nmAdd("rec_legitimacy", -1); nmAfterQ7(); // ESCALATION
            }
            break;
        case 8103: nmAdd("rec_foreign", -2); nmAfterQ7(); break;
        case 8104: nmAdd("rec_foreign", 1); nmAdd("delivery", 1); nmAfterQ7(); break;

        // ---- Q8 — Parkland / guns ----
        case 8111: nmAdd("delivery", 1); nmAdd("rec_social", 1); nmAdd("rec_progressive", -1); nm.guns_result = "partial"; nmAfterQ8(); break;
        case 8112:
            if (nm.delivery >= 2) { nmAdd("delivery", 1); nmAdd("rec_social", 2); nmAdd("rec_progressive", 1); nm.guns_result = "win"; }
            else if (nm.delivery >= 0) { nmAdd("rec_social", 1); nm.guns_result = "partial"; }
            else { nmAdd("delivery", -1); nmAdd("rec_social", 1); nm.guns_result = "loss"; }
            nmAfterQ8(); break;
        case 8113: nmAdd("delivery", 1); nmAdd("rec_progressive", -1); nm.guns_result = "partial"; nmAfterQ8(); break;
        case 8114: nmAdd("delivery", 1); nmAdd("rec_social", 1); nm.guns_result = "partial"; nmAfterQ8(); break;

        // ---- Q9 — RBG vacancy ----
        case 8121: nmAdd("delivery", 1); nmAdd("rec_social", 1); nmAdd("rec_progressive", 1); nm.scotus_result = "win"; break;
        case 8122: nmAdd("delivery", 1); nmAdd("rec_progressive", -1); nmAdd("rec_social", -1); nm.scotus_result = "partial"; break;
        case 8123:
            if (nm.delivery >= 2) { nmAdd("delivery", 1); nmAdd("rec_social", 2); nmAdd("rec_progressive", 1); nm.scotus_result = "win"; }
            else { nmAdd("delivery", -1); nmAdd("rec_progressive", 1); nm.scotus_result = "loss"; }
            break;
        case 8124:
            nmAdd("rec_social", 1); nmAdd("rec_legitimacy", -1); nm.scotus_result = "partial";
            nm.harris_scotus = true; // bible §3.1 — feeds the Q16 VP shortlist; the doc's FX line omits this
            break;

        // ---- Q10 — Crossfire Hurricane ----
        case 8131: nmAdd("rec_legitimacy", 2); break;
        case 8132: nmAdd("rec_progressive", 1); nmAdd("rec_legitimacy", -1); nm.norms_weaponized = true; break;
        case 8133: nmAdd("rec_progressive", -1); break;
        case 8134: nmAdd("rec_legitimacy", 1); break;

        // ---- Q11 — Executive Time (last drafted question; ends the run for now) ----
        // Jump lands question_number exactly on question_count (15) after the
        // increment — election night fires only on strict equality.
        case 8141: nmAdd("delivery", 1); nmAdd("rec_legitimacy", 1); nm.nato_tour = true; campaignTrail_temp.question_number = 14; break;
        case 8142: nmAdd("delivery", 2); nmAdd("rec_progressive", 1); nmAdd("rec_legitimacy", -1); nmAdd("warren_relationship", 1); nm.debt_relief = true; campaignTrail_temp.question_number = 14; break;
        case 8143: nm.midterm_push = true; campaignTrail_temp.question_number = 14; break;
        case 8144: nmAdd("delivery", 1); nmAdd("rec_labor", 2); nmAdd("rec_progressive", 1); campaignTrail_temp.question_number = 14; break;

        // ---- A HOUSE OF DYNAMITE terminal ----
        // No jump needed: index 14 + 1 = 15 = question_count, so the game ends.
        // TODO: replace election night with a proper ending screen at the pivot build.
        case 8151: break;
    }
};

