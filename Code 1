function nmSigned(v) { return (v > 0 ? "+" : "") + v; }

/* A centre-anchored bar for the clamped axes: the fill runs left or right
   of the midline in proportion to how far the axis has travelled. Graded
   accumulators (delivery, legitimacy) have no ceiling, so they get a
   number and no bar. */
function nmTrackerBar(v, clamp) {
    if (!clamp) return "";
    var pct = Math.min(Math.abs(v) / clamp, 1) * 50;
    var side = v < 0 ? "right:50%" : "left:50%";
    return "<span class='nm_tk_track'><span class='nm_tk_fill' style='" + side +
           ";width:" + pct + "%'></span></span>";
}

function nmTrackerHTML() {
    var h = "";
    for (var s = 0; s < NM_TRACKER.sections.length; s++) {
        var sec = NM_TRACKER.sections[s];
        h += "<div class='nm_tk_head'>" + sec.title + "</div>";
        for (var r = 0; r < sec.rows.length; r++) {
            var row = sec.rows[r], v = nm[row.key];
            h += "<div class='nm_tk_row'><span class='nm_tk_label'>" + row.label + "</span>" +
                 nmTrackerBar(v, row.clamp) +
                 "<span class='nm_tk_val" + (v > 0 ? " nm_tk_pos" : v < 0 ? " nm_tk_neg" : "") + "'>" +
                 nmSigned(v) + "</span></div>";
        }
    }
    var out = "";
    for (var o = 0; o < NM_TRACKER.outcomes.length; o++) {
        var oc = NM_TRACKER.outcomes[o], ov = nm[oc.key];
        if (!ov) continue;
        out += "<div class='nm_tk_row'><span class='nm_tk_label'>" + oc.label + "</span>" +
               "<span class='nm_tk_tag'>" + (NM_OUTCOME_LABEL[ov] || ov) + "</span></div>";
    }
    for (var m = 0; m < NM_TRACKER.marks.length; m++) {
        var mk = NM_TRACKER.marks[m];
        if (!nm[mk.key]) continue;
        out += "<div class='nm_tk_row'><span class='nm_tk_label'>" + mk.label + "</span>" +
               "<span class='nm_tk_tag'>yes</span></div>";
    }
    if (out) h += "<div class='nm_tk_head'>Outcomes</div>" + out;
    return h;
}

function nmPaintTracker() {
    try {
        var el = document.getElementById("nm_tracker_body");
        if (!el) return;
        el.innerHTML = nmTrackerHTML();
    } catch (e) { /* never let the read-out break the run */ }
}

/* The panel stays hidden through election select, candidate select and the
   bios, and appears with the first question. `#progress_bar` is built by the
   engine's questionHTML() and exists on no earlier screen, which makes it the
   cleanest "the game has actually started" marker available to a mod. */
function nmGameStarted() {
    return !!document.getElementById("progress_bar");
}

function nmWatchForGameStart(box) {
    if (nmGameStarted()) { box.style.display = ""; nmPaintTracker(); return; }
    box.style.display = "none";
    var poll = setInterval(function () {
        try {
            if (!nmGameStarted()) return;
            clearInterval(poll);
            box.style.display = "";
            nmPaintTracker();
        } catch (e) { clearInterval(poll); }
    }, 400);
}

function nmBuildTracker() {
    if (document.getElementById("nm_tracker")) return;
    var box = document.createElement("div");
    box.id = "nm_tracker";
    box.innerHTML =
        "<div id='nm_tracker_bar'><span>The Record</span>" +
        "<button type='button' id='nm_tracker_toggle' aria-expanded='true'>&minus;</button></div>" +
        "<div id='nm_tracker_body'></div>";
    document.body.appendChild(box);
    // Collapsed by default on narrow viewports, where it would sit over the map
    if (window.innerWidth < 1180) NM_TRACKER.open = false;
    var toggle = document.getElementById("nm_tracker_toggle");
    function applyOpen() {
        box.className = NM_TRACKER.open ? "" : "nm_tk_closed";
        toggle.innerHTML = NM_TRACKER.open ? "&minus;" : "+";
        toggle.setAttribute("aria-expanded", NM_TRACKER.open ? "true" : "false");
    }
    toggle.onclick = function () { NM_TRACKER.open = !NM_TRACKER.open; applyOpen(); };
    document.getElementById("nm_tracker_bar").onclick = function (ev) {
        if (ev.target !== toggle) { NM_TRACKER.open = !NM_TRACKER.open; applyOpen(); }
    };
    applyOpen();
    nmPaintTracker();
    nmWatchForGameStart(box);
}

