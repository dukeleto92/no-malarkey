/* questions_json indices (array order is what the engine walks; the
   `priority` field is inert at runtime):
   0 Q1 Inaugural · 1 Q2 Healthcare I · 2 Q3a · 3 Q3b · 4 Q3c · 5 Q3d ·
   6 Q4 Infrastructure · 7 Q5 TPP · 8 Q6 Afghanistan · 9 Q7 North Korea ·
   10 Q8 Guns · 11 Q9 RBG vacancy · 12 Q10 Crossfire Hurricane ·
   13 Q11 Executive Time · 14 Q12 Warren Relationship · 15 Q13 Midterms ·
   16 Q14 Immigration ·
   17 A HOUSE OF DYNAMITE (terminal, reached only via Q7 A2)

   The engine labels every screen "Question {question_number+1} of
   {question_count}", but question_number is an index into questions_json.
   Q3's four mutually exclusive branches occupy indices 2-5 and a player only
   ever plays one of them, so the native counter jumps at healthcare (2 goes
   straight to 6 on the Q3d route) and the parked terminal inflates the
   denominator. nmPaintProgress() below relabels it from NM_DISPLAY, purely
   as display: no jump target or question_count changes.

   Do NOT change question_count to 14 without also removing the branch
   indices; election night requires question_number === question_count
   exactly, and jumps target 16/17 against an 18-slot array. */

var nm = {
    // Tier A — bounded positional axes (bible §2). rec_progressive clamps at
    // -3..+3 (it has twelve sources and railed by Q6–Q8 on the old +-2);
    // every other Tier A axis stays at -2..+2.
    rec_progressive: 0,
    rec_social: 0,
    rec_foreign: 0,
    warren_relationship: 0,
    // Tier B — graded accumulators, unclamped, banded at read time
    delivery: 0,
    rec_legitimacy: 0,
    // Tier C — flavor tallies, clamp -3..+3
    rec_labor: 1, // "starts strong" (bible §2); exact start value TBD with thresholds
    rec_healthcare: 0,
    rec_infrastructure: 0,
    rec_immigration: 0,
    rec_trade: 0,
    // hidden counter (bible §3.2) — sources: Q1 A3, Q3a A2, Q12 A2, Q12 A4-fail
    hosts_burned: 0,
    // result flags (bible §3.1)
    route: null,
    healthcare_result: null,
    guns_result: null,
    scotus_result: null,
    norms_weaponized: false,
    harris_scotus: false,
    nato_tour: false, // see bible §9.2 — may become ukraine_trip
    debt_relief: false,
    // Q11 A3 → the 2-point discount on the Q13 A2/A3 gate (bible §3.1, §G)
    midterm_push: false,
    // Q13 result flag (bible §K): "win" | "partial" | "loss". Added in v0.9 so
    // Q13's delivery grants are derived by the write rule rather than hand-set.
    midterm_result: null,
    // Q13 outcome (bible §3.1): "status_quo" | "dem_house" | "gop_senate"
    congress_2019: null,
    // Q14 outcome (bible §3.1): "win" (a law) | "partial" (the pen) | "loss"
    immigration_result: null,
    // Q13 addendum flag — see NM_FAVREAU_GATE; also read for Q14 prose
    favreau_senate: false,
    // RNG pre-rolls for Q3c, rolled when Q2 routes there so feedback can be pre-written
    q3c_a2_success: null,
    q3c_a3_success: null,
    // GOP nominee, resolved by the cascade at the end of the govern phase
    // (bible §4.1 / the doc's candidate gate table). Holds the roster `key`
    // — "trump", "cruz", … — and stays null while the opposition is still
    // just "The Republicans".
    gop_nominee: null,
    terminal: null
};
window.nm = nm; // console debugging

var NM_TIER_A = ["rec_progressive", "rec_social", "rec_foreign", "warren_relationship"];
var NM_TIER_C = ["rec_labor", "rec_healthcare", "rec_infrastructure", "rec_immigration", "rec_trade"];

function nmAdd(tally, amt) {
    nm[tally] += amt;
    // bible §2 / validator item 11: rec_progressive is the only Tier A axis at +-3
    if (tally === "rec_progressive") nm[tally] = Math.max(-3, Math.min(3, nm[tally]));
    else if (NM_TIER_A.indexOf(tally) !== -1) nm[tally] = Math.max(-2, Math.min(2, nm[tally]));
    if (NM_TIER_C.indexOf(tally) !== -1) nm[tally] = Math.max(-3, Math.min(3, nm[tally]));
}

function nmSetFeedback(answerPk, text) {
    var fb = campaignTrail_temp.answer_feedback_json;
    for (var i = 0; i < fb.length; i++) {
        if (fb[i].fields.answer === answerPk) fb[i].fields.answer_feedback = text;
    }
}

