        and on the terminal screen show something like "Crisis" or hide the bar.

     3. Hook (pick one):
        a. setInterval / MutationObserver on #progress_bar (simplest, a bit crude)
        b. wrap window.questionHTML after load and call nmPaintProgress() at end
        c. jQuery ajaxComplete / DOMNodeInserted equivalent on #game_window

     4. Implementation sketch:

        var NM_SPINE_TOTAL = 14; // Q1–Q14; bump when Q15 (The Ticket) lands
        var NM_BRANCH_Q = { 803:1, 804:1, 805:1, 806:1 }; // exclusive slots
        function nmSpineShown() {
          // Count real answers (non-null) whose question is spine content.
          // Or maintain nm.progress.n++, incremented once per cyoAdventure call
          // except when landing on terminal-only 815.
          return nm.progress || 1;
        }
        function nmPaintProgress() {
          var el = document.querySelector("#progress_bar h3");
          if (!el) return;
          if (nm.terminal) { el.textContent = "Crisis"; return; }
